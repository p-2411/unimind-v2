model UserTopic {
  id               String    @id @default(cuid())
  topicName        String    @default("Untitled")
  userId           String    @db.Uuid
  topicId          String
  masteryScore     Float     @default(50) // 0-100, EMA with 15-day half-life. See src/server/lib/scoring/mastery.ts.
  masteryUpdatedAt DateTime  @default(now())
  correctCount     Int       @default(0)
  totalCount       Int       @default(0)
  lastAnsweredAt   DateTime?
  updatedAt        DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  // subtopics Subtopic[]
  @@unique([userId, topicId])
  @@index([userId])
  @@map("user_topics")
}

model UserCourse {
  id                  String   @id @default(cuid())
  userId              String   @db.Uuid
  courseId            String
  enrolledAt          DateTime @default(now())
  currentWeekOverride Int?

  user   User   @relation("UserCourseEnrollments", fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation("UserCourseEnrollments", fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@map("user_courses")
}

model UserQuestion {
  id         String @id @default(cuid())
  userId     String @db.Uuid
  questionId String

  // FSRS Card state — 1:1 with ts-fsrs Card type so state round-trips through f.next() with no field mapping.
  due           DateTime
  stability     Float     @default(0)
  difficulty    Float     @default(0)
  elapsedDays   Int       @default(0) // deprecated in ts-fsrs v6+; revisit when bumping the dep

  scheduledDays Int       @default(0)
  learningSteps Int       @default(0)
  reps          Int       @default(0)
  lapses        Int       @default(0)
  state         Int       @default(0) // 0=New, 1=Learning, 2=Review, 3=Relearning
  lastReview    DateTime?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, due])
  @@map("user_questions")
}

model QuestionAttempt {
  id          String   @id @default(cuid())
  userId      String   @db.Uuid
  questionId  String
  topicId     String // denormalized for cheap topic-scoped queries
  subtopicId  String? // denormalized for cheap subtopic-scoped queries
  isCorrect   Boolean
  rating      Int // 1=Again, 2=Hard, 3=Good, 4=Easy
  timeSpentMs Int      @default(0)
  source      String // "paywall" | "in_app" — analytics only
  answeredAt  DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  topic    Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  subtopic Subtopic? @relation(fields: [subtopicId], references: [id], onDelete: SetNull)

  @@index([userId, answeredAt])
  @@index([userId, topicId, answeredAt])
  @@index([userId, subtopicId, answeredAt])
  @@map("question_attempts")
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("admins")
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String?  @db.Uuid
  type      String   // "bug" | "suggestion" | "general"
  message   String   @db.Text
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("feedback")
}

// ============================================
// STUDY GROUPS
// ============================================

model StudyGroup {
  id         String   @id @default(cuid())
  name       String
  inviteCode String   @unique
  createdAt  DateTime @default(now())

  members  GroupMembership[]
  messages GroupMessage[]

  @@map("study_groups")
}

model GroupMembership {
  id       String   @id @default(cuid())
  userId   String   @db.Uuid
  groupId  String
  role     String   @default("member") // "owner" | "member"
  joinedAt DateTime @default(now())

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  group StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([groupId])
  @@map("group_memberships")
}

model GroupMessage {
  id        String   @id @default(cuid())
  groupId   String
  userId    String   @db.Uuid
  content   String   @db.Text
  createdAt DateTime @default(now())

  group StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
  @@map("group_messages")
}

// ============================================
// COURSE STRUCTURE
// ============================================

model Course {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String? // For UI theming
  icon        String? // Icon identifier
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  topics      Topic[]
  userCourses UserCourse[] @relation("UserCourseEnrollments")
  assessments Assessment[]
  problems    Problem[]
  startDate   DateTime?
  flexWeeks   Int[]        @default([]) // Calendar week numbers with no new content (e.g. [6] for UNSW T2)

  @@map("courses")
}

model Topic {
  id          String   @id @default(cuid())
  name        String
  description String?
  courseId    String
  weekNumber  Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course     Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  subTopics  Subtopic[]
  questions  Question[]
  userTopics UserTopic[]
  attempts   QuestionAttempt[]
  problems   Problem[]

  @@index([courseId])
  @@map("topics")
}

model Subtopic {
  id          String   @id @default(cuid())
  name        String
  description String?
  topicId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  topic     Topic             @relation(fields: [topicId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  QuestionAttempt[]

  @@index([topicId])
  @@map("subtopics")
}

// ============================================
// QUESTIONS
// ============================================

model Question {
  id          String   @id @default(cuid())
  question    String   @db.Text
  choices     String[] // Multiple choice options
  answerIndex Int // Index of the correct answer in choices array

  explanation String?  @db.Text
  difficulty  Int      @default(1) // 1-3 scale
  topicId     String
  subtopicId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  topic         Topic             @relation(fields: [topicId], references: [id], onDelete: Cascade)
  subtopic      Subtopic          @relation(fields: [subtopicId], references: [id], onDelete: Cascade)
  userQuestions UserQuestion[]
  attempts      QuestionAttempt[]

  @@index([topicId])
  @@index([subtopicId])
  @@index([difficulty])
  @@map("questions")
}

// ============================================
// ASSESSMENTS
// ============================================

model Assessment {
  id          String   @id @default(cuid())
  name        String
  courseId    String
  date        DateTime
  description String?  @db.Text
  weekFrom    Int?
  weekTo      Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  users  User[]

  @@index([courseId])
  @@index([date])
  @@map("assessments")
}

// ============================================
// PROBLEMS (exam-style, LeetCode-style)
// ============================================

model Problem {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  difficulty  String   @default("medium") // "easy" | "medium" | "hard"
  type        String   @default("code-writing") // "code-writing" | "code-tracing" | "short-answer" | "diagram"
  description String   @db.Text  // markdown
  hints       String[] // revealed progressively
  solution    String   @db.Text  // markdown
  courseId    String
  topicId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course   Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  topic    Topic?           @relation(fields: [topicId], references: [id], onDelete: SetNull)
  attempts ProblemAttempt[]

  @@index([courseId])
  @@index([topicId])
  @@map("problems")
}

model ProblemAttempt {
  id          String    @id @default(cuid())
  userId      String    @db.Uuid
  problemId   String
  selfRated   Boolean?  // null = attempted but not self-rated; true = got it; false = needs review
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@index([userId])
  @@map("problem_attempts")
}
